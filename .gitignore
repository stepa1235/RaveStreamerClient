# Root gitignore
**/build/
**/.dart_tool/
**/.flutter-plugins*
**/.idea/
**/.gradle/
**/local.properties
**/*.exe
**/*.apk
**/*.zip
**/*.bat
**/*.cmd
**/*.log
**/.agents/
**/.system_generated/
**/brain/

# Local configuration and server runtime files
/settings.json
**/node_modules/
**/.env
**/.env.*
!**/.env.example
/server/uploads/
/server/room_hosts.json
/server/yt-dlp*
**/ravestreamer_settings.json*
