# Export these variables through PM2 / your service manager; this file is not auto-loaded.
ADMIN_SECRET=
# Keep direct-access deployments at loopback. Set actual proxy CIDRs when adding a reverse proxy.
TRUST_PROXY=loopback
# Must match coturn use-auth-secret/static-auth-secret configuration.
TURN_SHARED_SECRET=
TURN_URLS=turn:185.70.184.237:3478?transport=udp,turn:185.70.184.237:3478?transport=tcp
# Gist updates / automatic tunnels are disabled when GITHUB_TOKEN is absent.
# Do not reuse the previously committed GitHub token.
GITHUB_TOKEN=
PUBLIC_URL=
